# Plantilla para producción (tenda-app.com). Copiar a `.env` en el VPS
# (fuera de git) y rellenar secretos. No usar valores de desarrollo.

TENDA_ENV=production
DJANGO_SETTINGS_MODULE=tenda.settings.prod
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=tenda-app.com,www.tenda-app.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://tenda-app.com,https://www.tenda-app.com
WEB_ORIGIN=https://tenda-app.com
PUBLIC_API_URL=https://tenda-app.com

# Admin: restringir por red (WireGuard / IP admin). Nunca 0.0.0.0/0 en prod real.
DJANGO_ADMIN_PATH=admin
DJANGO_ADMIN_ALLOWED_NETWORKS=10.42.0.0/24
DJANGO_ADMIN_TRUST_X_FORWARDED_FOR=true

OUTBOX_ENCRYPTION_KEY=replace-me
CREDENTIAL_ENCRYPTION_KEY=replace-me

POSTGRES_DB=tenda
POSTGRES_USER=tenda
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

AGENT_FEATURE_STATUS=coming_soon
SALES_RESERVATION_TTL_SECONDS=28800

# Turnstile (widget real en prod)
TURNSTILE_FAKE_MODE=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Object storage
OBJECT_STORAGE_PROVIDER=r2
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PREFIX=prod

# Email
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Tenda

# Mercado Pago seller + billing SaaS
PAYMENT_PROVIDER=mercado_pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_ENVIRONMENT=production
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_OAUTH_CALLBACK_URL=https://tenda-app.com/api/v1/integrations/mercado-pago/callback
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_URL=https://tenda-app.com/api/v1/webhooks/mercado-pago

BILLING_PROVIDER=mercado_pago
MERCADO_PAGO_BILLING_ACCESS_TOKEN=
MERCADO_PAGO_BILLING_WEBHOOK_SECRET=
BILLING_BACK_URL=https://tenda-app.com/app/configuracion/plan
BILLING_PAST_DUE_GRACE_DAYS=3

# Auth Google (opcional)
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_CALLBACK_URL=https://tenda-app.com/api/v1/auth/social/google/callback

# Observability / backups
SENTRY_DSN=
LOG_LEVEL=INFO
BACKUP_R2_BUCKET=
BACKUP_R2_PREFIX=prod/backups
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_PATH=./secrets/backup-age.key

# Imágenes las fija deploy.sh (no hace falta en .env del host para CD).
# TENDA_BACKEND_IMAGE / TENDA_BACKUP_IMAGE se exportan desde el workflow.

# Puerto HTTP del edge (solo 80 hacia Cloudflare; no abrir 443 en origen).
TENDA_HTTP_PORT=80
