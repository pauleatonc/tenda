# Runtime
TENDA_ENV=local
DJANGO_SETTINGS_MODULE=tenda.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
# IP LAN si Expo Go corre en un teléfono físico.
REACT_NATIVE_PACKAGER_HOSTNAME=
AGENT_FEATURE_STATUS=coming_soon
DJANGO_ADMIN_PATH=admin
DJANGO_ADMIN_ALLOWED_NETWORKS=
DJANGO_ADMIN_TRUST_X_FORWARDED_FOR=false

# PostgreSQL
POSTGRES_DB=tenda
POSTGRES_USER=tenda
POSTGRES_PASSWORD=replace-for-non-local-environments
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Redis and Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Authentication providers
# Vacío: usa Google si hay client id/secret. `fake` fuerza el adapter local.
GOOGLE_OIDC_PROVIDER=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_CALLBACK_URL=http://localhost:8000/api/v1/auth/social/google/callback
LINKEDIN_OIDC_ENABLED=false
LINKEDIN_OIDC_CLIENT_ID=
LINKEDIN_OIDC_CLIENT_SECRET=
LINKEDIN_OIDC_CALLBACK_URL=http://localhost:8000/api/v1/auth/social/linkedin/callback

# Cloudflare Turnstile and R2
# Local: TURNSTILE_FAKE_MODE=true (sin widget). Dev/Prod: false + site/secret.
TURNSTILE_FAKE_MODE=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
OUTBOX_EAGER=false
OUTBOX_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY=
# Local: `local` escribe y sirve desde backend/media/. Dev/Prod: `r2`. Tests: `fake`.
# MEDIA_ROOT opcional; por defecto es backend/media (en Docker, /app/media).
OBJECT_STORAGE_PROVIDER=local
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Archivos de la app (fotos + documentos). Prefijo: local | dev | prod
R2_BUCKET_NAME=
R2_PREFIX=local
R2_UPLOAD_TTL_SECONDS=900
R2_DOWNLOAD_TTL_SECONDS=300

# Brevo (transporte). Las plantillas viven en apps/notifications/email_templates.py
EMAIL_PROVIDER=fake
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Tenda
BREVO_WEBHOOK_SECRET=

# Mercado Pago
PAYMENT_PROVIDER=fake
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_ENVIRONMENT=sandbox
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/integrations/mercado-pago/callback
MERCADO_PAGO_WEBHOOK_SECRET=
PAYMENT_OAUTH_STATE_TTL_SECONDS=600
MERCADO_PAGO_COMMISSION_MODE=disabled
MERCADO_PAGO_COMMISSION_RATE=0
MERCADO_PAGO_COMMISSION_MINIMUM=0

# Observability and operations
SENTRY_DSN=
LOG_LEVEL=INFO
# Dumps cifrados. Bucket distinto al de archivos.
BACKUP_R2_BUCKET=
BACKUP_R2_PREFIX=local/backups
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_PATH=./secrets/backup-age.key
TENDA_BACKEND_IMAGE=tenda-backend:local
TENDA_WEB_IMAGE=tenda-web:local
TENDA_BACKUP_IMAGE=tenda-backup:local
